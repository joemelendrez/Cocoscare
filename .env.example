# Coco's Supabase project (Project Settings > API). Without these the site
# shows sample content and /admin says it isn't connected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://cocoscare.com
# Posts sent from Handoff Hero land on this WordPress subsite. The blog
# shows the live ones (WPGraphQL); set to off to show only /admin posts.
WORDPRESS_GRAPHQL_URL=https://cms.habitnova.com/cocoscare/graphql
# /admin's "From Handoff Hero" list reads drafts too, so it needs a login:
# a WordPress Application Password (wp-admin > Users > Profile). Server only.
WORDPRESS_SITE_URL=https://cms.habitnova.com/cocoscare
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# From Pinterest > Settings > Claimed accounts (the p:domain_verify code).
PINTEREST_DOMAIN_VERIFY=

# Mailchimp list for the blog signup form (Account > Extras > API keys; Audience > Settings for the id).
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Resend, for the recipe card's "Email me this" button (verify cocoscare.com
# under Domains first). RESEND_FROM is optional.
RESEND_API_KEY=
RESEND_FROM="Coco's Care <recipes@cocoscare.com>"
